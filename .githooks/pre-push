#!/bin/sh
# Runs the same core checks as CI before a push, so a stale local test run can't ship failing tests.
# Enable once per clone: git config core.hooksPath .githooks   (skip in an emergency: git push --no-verify)
set -e
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "pre-push: commit or stash local changes first, so the checks test what you push." >&2
  exit 1
fi
node tools/build-demo.mjs >/dev/null
if ! git diff --quiet -- index.html docs/ js/app.bundle.js packs/active-pack.js packs/relationships.js sw.js icons/; then
  echo "pre-push: generated files are out of date. Commit what tools/build-demo.mjs just rebuilt, then push." >&2
  exit 1
fi
node --test tests/*.test.mjs >/dev/null 2>&1 || { echo "pre-push: tests fail. Run: node --test tests/*.test.mjs" >&2; exit 1; }
echo "pre-push: generated files current and tests pass."
